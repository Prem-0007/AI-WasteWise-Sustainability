# AI WasteWise – optional live AI configuration.
# Leave VITE_AI_API_KEY empty and the app still works using its built-in analysis engine.
# Copy this file to ".env" (never commit .env) and restart "npm run dev" after editing.

VITE_AI_API_KEY=

# "openai" (default – also works with OpenAI-compatible APIs) or "anthropic"
VITE_AI_PROVIDER=openai

# Optional: override the default model
#   openai default:    gpt-4o-mini
#   anthropic default: claude-haiku-4-5-20251001
VITE_AI_MODEL=

# Optional: custom base URL for an OpenAI-compatible provider (e.g. https://api.groq.com/openai/v1)
VITE_AI_BASE_URL=
